# Copy this file to ".env" and fill in your own keys. Never commit ".env".

# API keys (one per provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Maximum spend for one run, in EUR. "plan" warns and "run" refuses above this.
BUDGET_EUR=150

# How many times each question is asked (same hotel, prompt, engine, mode)
REPETITIONS=3
