# Copy this file to ".env" and fill in your own keys. Never commit ".env".

# API keys (one per provider). Use the MHC_ names: a Claude Code cloud session
# does not pass ANTHROPIC_API_KEY through to the commands it runs.
MHC_OPENAI_API_KEY=
MHC_ANTHROPIC_API_KEY=
MHC_GEMINI_API_KEY=
MHC_PERPLEXITY_API_KEY=

# Maximum spend for one run, in EUR. "plan" warns and "run" refuses above this.
BUDGET_EUR=150

# How many times each question is asked (same hotel, prompt, engine, mode)
REPETITIONS=3
